{
  "name": "west-peek-community",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "npm run build && npm run test:lead && npm run test:dashboard && npm run validate:dashboard-privacy && npm run validate:forms && npm run validate:disclosure && npm run validate:ventures-isolation && npm run validate:community-site",
    "validate:forms": "node scripts/validate_forms.mjs",
    "validate:disclosure": "node scripts/validate_disclosure.mjs",
    "validate:ventures-isolation": "node scripts/validate_ventures_isolation.mjs",
    "lastmod": "node scripts/lastmod_from_git.mjs",
    "lastmod:check": "node scripts/lastmod_from_git.mjs --check",
    "build:community": "node scripts/build.mjs community",
    "build:ventures": "node scripts/build.mjs ventures",
    "build:productions": "node scripts/build.mjs productions",
    "build": "node scripts/build.mjs community && node scripts/build.mjs ventures && node scripts/build.mjs productions",
    "portfolio:status": "node scripts/portfolio_status.mjs --write",
    "validate:community-site": "node scripts/validate_community_site.mjs",
    "mailer:deploy": "cd workers/forms-mailer && npx wrangler@4.151.0 deploy",
    "test:lead": "node scripts/test_lead_delivery.mjs",
    "test:dashboard": "node scripts/test_dashboard.mjs",
    "dashboard:owners": "node scripts/dashboard_owners.mjs",
    "validate:dashboard-privacy": "node scripts/validate_dashboard_privacy.mjs",
    "dashboard:setup": "node scripts/dashboard_setup.mjs",
    "first-run": "node scripts/dashboard_first_run.mjs"
  },
  "engines": {
    "node": ">=22.13"
  }
}
