# Community Viability Assessment — safe deployment contract.
# Never commit active keys or tokens. Configure these in the Productions
# Cloudflare Pages project. Existing Pitch Lab values may be reused through the
# secret manager, but must not be copied into this file.
PUBLIC_APP_URL=https://westpeekproductions.com
ALLOW_CLOUDFLARE_PREVIEW_ORIGIN=false
AVATAR_DYNAMIC_GENERATION_ENABLED=false
AVATAR_PROVIDER=did
AVATAR_SECONDARY_PROVIDER=heygen
AVATAR_MAX_SCRIPT_CHARS=1200
TURNSTILE_SECRET_KEY=DISABLED_UNTIL_WIDGET_IS_CONFIGURED
DID_API_KEY=REPLACE_WITH_SECRET
DID_API_BASE_URL=https://api.d-id.com
DID_SOURCE_URL=REPLACE_WITH_PUBLIC_SCOOTER_SOURCE_IMAGE_URL
DID_VOICE_PROVIDER=microsoft
DID_VOICE_ID=en-US-GuyNeural
HEYGEN_API_KEY=REPLACE_WITH_SECRET
HEYGEN_API_BASE_URL=https://api.heygen.com
HEYGEN_AVATAR_ID=REPLACE_WITH_APPROVED_AVATAR_ID
HEYGEN_TALKING_PHOTO_ID=REPLACE_WITH_APPROVED_TALKING_PHOTO_ID
HEYGEN_VOICE_ID=REPLACE_WITH_APPROVED_VOICE_ID
HEYGEN_TEST_MODE=false
